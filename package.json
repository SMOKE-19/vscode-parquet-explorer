{
  "name": "pq-explorer",
  "displayName": "PQ Explorer",
  "description": "Read-only DuckDB Parquet Explorer for VS Code.",
  "version": "0.1.4",
  "publisher": "smoke-19",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMOKE-19/vscode-parquet-explorer.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "main": "./extension.js",
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@lezer/highlight": "^1.2.3",
    "@vscode/vsce": "4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2"
  },
  "activationEvents": [
    "onCommand:pqExplorer.openParquetExplorer",
    "onCustomEditor:pqExplorer.parquetExplorer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "pqExplorer.parquetExplorer",
        "displayName": "PQ Explorer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pqExplorer.openParquetExplorer",
        "title": "PQ Explorer: Open Parquet"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pqExplorer.openParquetExplorer",
          "when": "resourceExtname == .parquet",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PQ Explorer",
      "properties": {
        "pqExplorer.pythonPath": {
          "type": "string",
          "default": "",
          "description": "duckdb가 설치된 Python 실행 파일. 비워두면 workspace 내 가상환경을 탐색합니다."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check favorites.js && node --check bridge.js && node --check media/explorer.js && node --check media/sql-editor.source.mjs",
    "build": "esbuild media/sql-editor.source.mjs --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=media/sql-editor.js",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test tests/*.test.js",
    "package": "vsce package --out dist/pq-explorer-0.1.4.vsix"
  }
}
