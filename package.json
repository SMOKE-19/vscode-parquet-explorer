{
  "name": "pq-explorer",
  "displayName": "PQ Explorer",
  "description": "Read-only DuckDB viewer for Parquet, CSV, TSV, SBDF and Excel files.",
  "version": "0.1.14",
  "publisher": "smoke-19",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMOKE-19/vscode-parquet-explorer.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "categories": [
    "Data Science",
    "Visualization"
  ],
  "main": "./extension.js",
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/view": "^6.38.6",
    "@lezer/highlight": "^1.2.3",
    "@types/detect-libc": "1.0.3",
    "@types/node": "22.20.5",
    "@types/vscode": "1.90.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vscode/vsce": "4.0.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "read-excel-file": "9.3.12",
    "saxen": "11.2.0",
    "typescript": "5.9.3",
    "yazl": "2.5.1"
  },
  "activationEvents": [
    "onCommand:pqExplorer.openParquetExplorer",
    "onCustomEditor:pqExplorer.parquetExplorer"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "pqExplorer.parquetExplorer",
        "displayName": "PQ Explorer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.pq"
          },
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.sbdf"
          },
          {
            "filenamePattern": "*.xlsx"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "pqExplorer.openParquetExplorer",
        "title": "PQ Explorer: Open Data File"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pqExplorer.openParquetExplorer",
          "when": "resourceExtname =~ /\\.(parquet|pq|csv|tsv|sbdf|xlsx)$/i",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "PQ Explorer",
      "properties": {
        "pqExplorer.queryTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 86400,
          "description": "SQL 실행 제한 시간(초). 0이면 시간 제한을 사용하지 않습니다."
        },
        "pqExplorer.exactResultCount": {
          "type": "boolean",
          "default": false,
          "description": "각 SQL 결과의 정확한 전체 행 수를 계산합니다. 대용량 데이터에서는 첫 페이지 표시가 늦어질 수 있습니다."
        },
        "pqExplorer.duckdbMemoryLimit": {
          "type": "string",
          "default": "2GB",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(KB|MB|GB|TB)$",
          "description": "DuckDB 메모리 상한(예: 2GB)."
        },
        "pqExplorer.duckdbThreads": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 64,
          "description": "DuckDB가 사용할 최대 worker thread 수."
        },
        "pqExplorer.duckdbTempDirectory": {
          "type": "string",
          "default": "",
          "description": "메모리 초과 데이터를 저장할 임시 폴더. 상대 경로는 workspace 기준이며, 비워두면 DuckDB 기본값을 사용합니다."
        },
        "pqExplorer.duckdbMaxTempSize": {
          "type": "string",
          "default": "10GB",
          "pattern": "^[1-9][0-9]*(\\.[0-9]+)?(KB|MB|GB|TB)$",
          "description": "DuckDB 임시 디스크 사용 상한(예: 10GB)."
        },
        "pqExplorer.maxCellBytes": {
          "type": "integer",
          "default": 65536,
          "minimum": 1024,
          "maximum": 1048576,
          "description": "LIST, STRUCT, bytes 셀 하나의 전송 상한(byte). 초과 내용은 잘림 메타데이터와 함께 전송됩니다."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc -p tsconfig.node.json && tsc -p tsconfig.webview.json",
    "build": "npm run check && npm run build:node && npm run build:webview",
    "vscode:prepublish": "npm run build",
    "test": "npm run build && node --test tests/*.test.js",
    "package": "npm run build && node scripts/package_vsix.js",
    "benchmark": "npm run build && node scripts/benchmark.js",
    "build:node": "esbuild src/extension.ts src/bridge.ts src/favorites.ts src/engine/parquet.ts src/engine/formats.ts src/engine/sbdf.ts src/engine/sql.ts src/engine/values.ts src/engine/worker.ts src/scripts/*.ts src/shared/errors.ts --outbase=src --outdir=. --platform=node --target=node18 --format=cjs && esbuild src/engine/xlsx-reader.ts --bundle --format=cjs --platform=node --target=node18 --minify --outfile=engine/xlsx-reader.js --metafile=dist/xlsx-reader-meta.json",
    "build:webview": "esbuild src/media/explorer.ts --bundle --format=iife --platform=browser --target=es2022 --outfile=media/explorer.js && esbuild src/media/sql-editor.ts --bundle --format=iife --platform=browser --target=es2022 --minify --outfile=media/sql-editor.js"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "yauzl": "3.4.0"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "parquet",
    "duckdb",
    "sql",
    "data",
    "viewer",
    "dataset",
    "csv",
    "sbdf",
    "excel",
    "xlsx"
  ],
  "galleryBanner": {
    "color": "#093b2b",
    "theme": "dark"
  }
}
