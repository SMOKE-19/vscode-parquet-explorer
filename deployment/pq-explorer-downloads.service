[Unit]
Description=PQ Explorer Tailnet VSIX downloads
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dev/projects/pkgs_active/vscode-extention/vscode-parquet-explorer
ExecStart=/usr/bin/python -m http.server 8787 --bind 100.109.190.96 --directory %h/dev/projects/pkgs_active/vscode-extention/vscode-parquet-explorer/dist/downloads
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
